{
  "name": "lovefit-bot",
  "version": "1.0.0",
  "private": true,
  "description": "LOVE FIT WhatsApp bot v2 — conversation engine + admin panel",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "import-blacklist": "tsx scripts/import-blacklist.ts",
    "create-franchise": "tsx scripts/create-franchise.ts",
    "purge": "tsx scripts/purge.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "ioredis": "5.11.1",
    "next": "15.5.29",
    "prisma": "6.19.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
