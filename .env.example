# ───────────────────────────────────────────────────────────────
# LOVE FIT Bot v2 — copie para .env e preencha. NUNCA versione o .env.
# Gere cada segredo com:  openssl rand -hex 32
# Depois de preencher:     chmod 600 .env
# ───────────────────────────────────────────────────────────────

# Sobe também o container cloudflared (Cloudflare Tunnel). Na VPS: deixe "tunnel".
# Para rodar sem túnel (ksserver / teste local), deixe vazio: COMPOSE_PROFILES=
COMPOSE_PROFILES=tunnel

# Chave da Evolution API (NOVA — não reaproveite a do bot antigo)
AUTHENTICATION_API_KEY=

# Senha do Postgres (app + Evolution)
POSTGRES_PASSWORD=

# Token que a Evolution manda no webhook para o app (?token=...)
WEBHOOK_TOKEN=

# Segredo das sessões do painel (mínimo 32 caracteres)
SESSION_SECRET=

# Token do túnel: Cloudflare Zero Trust → Networks → Tunnels → lovefit-bot
TUNNEL_TOKEN=

# Fuso horário para saudação, horários e métricas
TIMEZONE=America/Sao_Paulo

# Porta do painel no host. Fica só em 127.0.0.1 (acesso por túnel SSH ou Cloudflare).
PANEL_PORT=3000
# PANEL_BIND=127.0.0.1   # use 0.0.0.0 só em máquina de rede local (ksserver/NetBird)

# Limite de upload de imagem/PDF (MB)
MEDIA_MAX_MB=10

# Cookie seguro: auto (HTTPS via Cloudflare) | true | false
COOKIE_SECURE=auto
